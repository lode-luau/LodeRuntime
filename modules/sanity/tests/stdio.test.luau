
-- Standard I/O (stdio) module tests: API surface, stream objects (stdin, stdout, stderr),
-- OOP methods, signals, error handling, and backward-compatible functions.

local sanity = require("../init")
local describe = sanity.describe
local it = sanity.it
local expect = sanity.expect

local stdio = require("../../stdio")

describe("stdio", function()
    it("exposes stdin, stdout, and stderr stream objects", function()
        expect(typeof(stdio.stdin)).toBe("userdata")
        expect(typeof(stdio.stdout)).toBe("userdata")
        expect(typeof(stdio.stderr)).toBe("userdata")
    end)

    it("exposes StdioStream class factory and utility functions", function()
        expect(typeof(stdio.StdioStream)).toBe("table")
        expect(typeof(stdio.StdioStream.Create)).toBe("function")
        expect(typeof(stdio.IsTTY)).toBe("function")
        expect(typeof(stdio.isTTY)).toBe("function")
        expect(typeof(stdio.print)).toBe("function")
        expect(typeof(stdio.eprint)).toBe("function")
        expect(typeof(stdio.write)).toBe("function")
        expect(typeof(stdio.prompt)).toBe("function")
        expect(typeof(stdio.clear)).toBe("function")
        expect(typeof(stdio.select)).toBe("function")
    end)

    it("stream objects have expected methods and signals", function()
        -- Stdin
        expect(typeof(stdio.stdin.Read)).toBe("function")
        expect(typeof(stdio.stdin.read)).toBe("function")
        expect(typeof(stdio.stdin.ReadLine)).toBe("function")
        expect(typeof(stdio.stdin.readLine)).toBe("function")
        expect(typeof(stdio.stdin.ReadBuffer)).toBe("function")
        expect(typeof(stdio.stdin.readBuffer)).toBe("function")
        expect(typeof(stdio.stdin.ReadInto)).toBe("function")
        expect(typeof(stdio.stdin.readInto)).toBe("function")
        expect(typeof(stdio.stdin.ReadAsync)).toBe("function")
        expect(typeof(stdio.stdin.readAsync)).toBe("function")
        expect(typeof(stdio.stdin.StartStreaming)).toBe("function")
        expect(typeof(stdio.stdin.StopStreaming)).toBe("function")
        expect(typeof(stdio.stdin.IsTTY)).toBe("function")
        expect(typeof(stdio.stdin.isTTY)).toBe("function")
        expect(typeof(stdio.stdin.IsOpen)).toBe("function")
        expect(typeof(stdio.stdin.SetRawMode)).toBe("function")
        expect(typeof(stdio.stdin.setRawMode)).toBe("function")

        expect(typeof(stdio.stdin.DataReceived)).toBe("table")
        expect(typeof(stdio.stdin.DataReceived.Connect)).toBe("function")
        expect(typeof(stdio.stdin.EndOfStream)).toBe("table")
        expect(typeof(stdio.stdin.EndOfStream.Connect)).toBe("function")
        expect(typeof(stdio.stdin.ErrorOccurred)).toBe("table")
        expect(typeof(stdio.stdin.ErrorOccurred.Connect)).toBe("function")

        -- Stdout
        expect(typeof(stdio.stdout.Write)).toBe("function")
        expect(typeof(stdio.stdout.write)).toBe("function")
        expect(typeof(stdio.stdout.WriteLine)).toBe("function")
        expect(typeof(stdio.stdout.writeLine)).toBe("function")
        expect(typeof(stdio.stdout.GetWindowSize)).toBe("function")
        expect(typeof(stdio.stdout.getWindowSize)).toBe("function")
        expect(typeof(stdio.stdout.IsTTY)).toBe("function")
        expect(typeof(stdio.stdout.isTTY)).toBe("function")
        expect(typeof(stdio.stdout.IsOpen)).toBe("function")
        expect(typeof(stdio.stdout.ErrorOccurred)).toBe("table")
        expect(typeof(stdio.stdout.ErrorOccurred.Connect)).toBe("function")
        expect(typeof(stdio.stdout.WindowResized)).toBe("table")
        expect(typeof(stdio.stdout.WindowResized.Connect)).toBe("function")
    end)

    it("checks IsTTY without throwing", function()
        local stdinTty = stdio.IsTTY(0)
        local stdoutTty = stdio.IsTTY(1)
        local stderrTty = stdio.IsTTY(2)
        expect(type(stdinTty)).toBe("boolean")
        expect(type(stdoutTty)).toBe("boolean")
        expect(type(stderrTty)).toBe("boolean")
        expect(stdio.stdin:IsTTY()).toBe(stdinTty)
        expect(stdio.stdout:IsTTY()).toBe(stdoutTty)
        expect(stdio.stderr:IsTTY()).toBe(stderrTty)
    end)

    it("rejects IsTTY with invalid argument", function()
        local ok, err = pcall(function()
            (stdio.IsTTY :: any)("bad")
        end)
        expect(ok).toBe(false)
        expect(tostring(err):find("fd must be a number", 1, true) ~= nil).toBe(true)
    end)

    it("rejects StdioStream.Create with invalid arguments", function()
        local create: any = stdio.StdioStream.Create
        local ok, err = pcall(function()
            create("1", false)
        end)
        expect(ok).toBe(false)
        expect(tostring(err):find("expected fd (number) and readable (boolean)", 1, true) ~= nil).toBe(true)
    end)

    it("rejects Write on stdin (not writable / read stream)", function()
        local ok, err = pcall(function()
            stdio.stdin:Write("test")
        end)
        expect(typeof(ok)).toBe("boolean")
    end)

    it("GetWindowSize returns dimension table", function()
        local size = stdio.stdout:GetWindowSize()
        expect(typeof(size)).toBe("table")
        expect(typeof(size.width)).toBe("number")
        expect(typeof(size.height)).toBe("number")
        expect(typeof(size.columns)).toBe("number")
        expect(typeof(size.rows)).toBe("number")
    end)

    it("compatibility functions work properly", function()
        expect(typeof(stdio.print)).toBe("function")
        expect(typeof(stdio.eprint)).toBe("function")
        expect(typeof(stdio.write)).toBe("function")
        expect(typeof(stdio.prompt)).toBe("function")
        expect(typeof(stdio.clear)).toBe("function")
    end)
end)
