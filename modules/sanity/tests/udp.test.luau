
local sanity = require("../init")
local describe = sanity.describe
local it = sanity.it
local expect = sanity.expect

local task = require("../../../modules/task")
local udp = require("../../udp")

describe("udp", function()
    it("exposes the UdpSocket class", function()
        expect(typeof(udp.UdpSocket)).toBe("table")
        expect(typeof(udp.UdpSocket.Create)).toBe("function")
    end)

    it("exposes multicast and datagram socket options", function()
        expect(typeof(udp.UdpSocket.Create)).toBe("function")
        local socket = udp.UdpSocket:Create()
        socket:Bind("0.0.0.0", 0)
        socket:SetBroadcast(true)
        socket:SetBroadcast(false)
        socket:SetTTL(64)
        socket:SetMulticastLoop(true)
        socket:SetMulticastLoop(false)
        local joined = pcall(function()
            socket:JoinGroup("239.255.0.1")
        end)
        if joined then
            socket:LeaveGroup("239.255.0.1")
        end
        socket:Close()
    end)

    it("rejects Bind on an invalid host", function()
        local ok, err = pcall(function()
            udp.UdpSocket:Create():Bind("not an ip address", 12345)
        end)
        expect(ok).toBe(false)
        local msg = tostring(err)
        expect(msg:find("IPv4 or IPv6 address", 1, true) ~= nil).toBe(true)
    end)

    it("rejects Bind with invalid port", function()
        local ok, err = pcall(function()
            udp.UdpSocket:Create():Bind("127.0.0.1", -1)
        end)
        expect(ok).toBe(false)
        local msg = tostring(err)
        expect(msg:find("port must be an integer", 1, true) ~= nil).toBe(true)
    end)

    it("rejects Bind twice on the same socket", function()
        local socket = udp.UdpSocket:Create()
        socket:Bind("127.0.0.1", 0)
        local ok, err = pcall(function()
            socket:Bind("127.0.0.1", 0)
        end)
        expect(ok).toBe(false)
        expect(tostring(err):find("already bound", 1, true) ~= nil).toBe(true)
        socket:Close()
    end)

    it("rejects Send on unbound socket", function()
        local ok, err = pcall(function()
            udp.UdpSocket:Create():Send("hello", "127.0.0.1", 12345)
        end)
        expect(ok).toBe(false)
        local msg = tostring(err)
        expect(msg:find("not bound", 1, true) ~= nil).toBe(true)
    end)

    it("rejects LocalAddress on unbound socket", function()
        local ok, err = pcall(function()
            udp.UdpSocket:Create():LocalAddress()
        end)
        expect(ok).toBe(false)
        local msg = tostring(err)
        expect(msg:find("not bound", 1, true) ~= nil).toBe(true)
    end)

    it("rejects Send with non-string/buffer data", function()
        local s = udp.UdpSocket:Create()
        s:Bind("127.0.0.1", 0)
        local ok, err = pcall(function()
            s:Send(123 :: any, "127.0.0.1", 12345)
        end)
        s:Close()
        expect(ok).toBe(false)
        local msg = tostring(err)
        expect(msg:find("data must be a string or buffer", 1, true) ~= nil).toBe(true)
    end)
    
    it("rejects Send with invalid destination host", function()
        local s = udp.UdpSocket:Create()
        s:Bind("127.0.0.1", 0)
        local ok, err = pcall(function()
            s:Send("hello", "not an ip", 12345)
        end)
        s:Close()
        expect(ok).toBe(false)
        local msg = tostring(err)
        expect(msg:find("IPv4 or IPv6 address", 1, true) ~= nil).toBe(true)
    end)

    it("rejects missing port in Bind", function()
        local ok, err = pcall(function()
            udp.UdpSocket:Create():Bind("127.0.0.1")
        end)
        expect(ok).toBe(false)
        local msg = tostring(err)
        expect(msg:find("port must be a number", 1, true) ~= nil).toBe(true)
    end)

    it("rejects missing port in Send", function()
        local s = udp.UdpSocket:Create()
        s:Bind("127.0.0.1", 0)
        local ok, err = pcall(function()
            s:Send("hello", "127.0.0.1")
        end)
        s:Close()
        expect(ok).toBe(false)
        local msg = tostring(err)
        expect(msg:find("port must be a number", 1, true) ~= nil).toBe(true)
    end)
end)

describe("udp send/receive", function()
    it("exchanges datagrams between two bound sockets", function()
        local server = udp.UdpSocket:Create()
        server:Bind("127.0.0.1", 0)
        local serverAddr = server:LocalAddress()

        local serverGot: any = nil
        server.MessageReceived:Connect(function(msg, addr)
            serverGot = msg
            server:Send("pong", addr.host, addr.port)
        end)

        local client = udp.UdpSocket:Create()
        client:Bind("127.0.0.1", 0)

        local clientGot: any = nil
        client.MessageReceived:Connect(function(msg)
            clientGot = msg
        end)

        client:Send("ping", serverAddr.host, serverAddr.port)
        task.wait(0.2)

        expect(serverGot).toBe("ping")
        expect(clientGot).toBe("pong")

        client:Close()
        server:Close()
    end)
end)
