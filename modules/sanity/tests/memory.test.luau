local sanity = require("../init")
local describe = sanity.describe
local it = sanity.it
local expect = sanity.expect

local Memory = require("../../memory")
local Address = require("../../address")

describe("Memory", function()
    it("allocates zeroed aligned blocks with observable state", function()
        local block = Memory.new(32, { Zeroed = true, Alignment = 16 })
        expect(Memory.IsAlive(block)).toBe(true)
        expect(Memory.Size(block)).toBe(32)
        local pointer = Memory.Address(block)
        expect(Address.Read.U32(pointer, 0)).toBe(0)
        expect(pcall(Memory.new, -1)).toBe(false)
        expect(pcall(Memory.new, 1.5)).toBe(false)
        expect(pcall(Memory.new, 4, true)).toBe(false)
        expect(pcall(Memory.new, 4, { Alignment = 3 })).toBe(false)
        expect(pcall(Memory.new, 4, { Alignment = -8 })).toBe(false)
        expect(pcall(Memory.new, 4, { Zeroed = 1 })).toBe(false)
        expect(pcall(Memory.new, 4, { Unknown = true })).toBe(false)
        expect(pcall(Memory.Address, block, 33)).toBe(false)
        Memory.Free(block)
    end)

    it("resizes blocks while preserving the common prefix", function()
        local block = Memory.new(8, { Zeroed = true, Alignment = 16 })
        local before = Memory.Address(block)
        Address.Write.U32(before, 0, 0x12345678)
        Memory.Resize(block, 16)
        local afterGrow = Memory.Address(block)
        expect(Memory.Size(block)).toBe(16)
        expect(Address.Read.U32(afterGrow, 0)).toBe(0x12345678)
        Memory.Resize(block, 4)
        local afterShrink = Memory.Address(block)
        expect(Memory.Size(block)).toBe(4)
        expect(Address.Read.U32(afterShrink, 0)).toBe(0x12345678)
        expect(pcall(Memory.Resize, block, -1)).toBe(false)
        Memory.Resize(block, 0)
        expect(Memory.Size(block)).toBe(0)
        expect(Memory.Address(block)).toBe(nil)
        Memory.Resize(block, 4)
        expect(Memory.Size(block)).toBe(4)
        Memory.Free(block)
    end)

    it("zeroes complete and partial ranges", function()
        local block = Memory.new(16, { Zeroed = false })
        local pointer = Memory.Address(block)
        Address.Fill(pointer, 0x7f, 16)
        Memory.Zero(block, 4, 8)
        expect(Address.Read.U8(pointer, 0)).toBe(0x7f)
        expect(Address.Read.U8(pointer, 4)).toBe(0)
        expect(Address.Read.U8(pointer, 11)).toBe(0)
        expect(Address.Read.U8(pointer, 12)).toBe(0x7f)
        Memory.Zero(block)
        expect(Address.Read.U8(pointer, 0)).toBe(0)
        expect(pcall(Memory.Zero, block, 15, 2)).toBe(false)
        expect(pcall(Memory.Zero, block, 17)).toBe(false)
        expect(pcall(Memory.Zero, block, 0, -1)).toBe(false)
        Memory.Free(block)
    end)

    it("frees idempotently and rejects further block operations", function()
        local block = Memory.new(4, { Zeroed = true })
        Memory.Free(block)
        Memory.Free(block)
        expect(Memory.IsAlive(block)).toBe(false)
        expect(Memory.Size(block)).toBe(0)
        expect(pcall(Memory.Address, block)).toBe(false)
        expect(pcall(Memory.Resize, block, 8)).toBe(false)
        expect(pcall(Memory.Zero, block)).toBe(false)
        expect(pcall(Memory.Size, {})).toBe(false)
        expect(pcall(Memory.IsAlive, {})).toBe(false)
        expect(pcall(Memory.Free, {})).toBe(false)
    end)
end)
