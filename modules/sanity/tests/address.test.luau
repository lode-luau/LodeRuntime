local sanity = require("../init")
local describe = sanity.describe
local it = sanity.it
local expect = sanity.expect

local Address = require("../../address")
local Memory = require("../../memory")
local FFI = require("../../ffi")
local sys = require("../../sys")

describe("Address", function()
    it("creates, compares, offsets, and casts opaque addresses", function()
        local block = Memory.new(32, { Zeroed = true, Alignment = 16 })
        local pointer = Memory.Address(block)
        expect(type(pointer)).toBe("userdata")
        expect(Address.Equals(pointer, Address.Of(block))).toBe(true)
        expect(Address.Equals(pointer, Address.Add(pointer, 0))).toBe(true)
        expect(Address.Equals(pointer, Address.Add(Address.Add(pointer, 8), -8))).toBe(true)
        expect(Address.Equals(pointer, Address.Of(block, 0))).toBe(true)
        expect(Address.Equals(pointer, Address.Cast("uint8_t*", pointer))).toBe(true)
        expect(Address.IsNull(nil)).toBe(true)
        expect(Address.IsNull(pointer)).toBe(false)
        expect(pcall(Address.Of, 123)).toBe(false)
        expect(pcall(Address.Cast, "uint32_t", pointer)).toBe(false)
        expect(pcall(Address.Cast, {}, pointer)).toBe(false)
        expect(pcall(Address.Add, pointer, 0 / 0)).toBe(false)
        expect(pcall(Address.Add, pointer, math.huge)).toBe(false)
        expect(pcall(Address.IsNull, 123)).toBe(false)
        expect(pcall(Address.Equals, pointer, 123)).toBe(false)
        Memory.Free(block)
    end)

    it("reads and writes every scalar form", function()
        local block = Memory.new(64, { Zeroed = true, Alignment = 16 })
        local p = Memory.Address(block)
        Address.Write.I8(p, 0, -7)
        Address.Write.U8(p, 1, 250)
        Address.Write.I16(p, 2, -1234)
        Address.Write.U16(p, 4, 65000)
        Address.Write.I32(p, 8, -123456)
        Address.Write.U32(p, 12, 0x12345678)
        Address.Write.I64(p, 16, -42)
        Address.Write.U64(p, 24, 42)
        Address.Write.F32(p, 32, 1.25)
        Address.Write.F64(p, 40, 3.5)
        Address.Write.Bool(p, 48, true)
        Address.Write.Pointer(p, 56, p)
        expect(Address.Read.I8(p, 0)).toBe(-7)
        expect(Address.Read.U8(p, 1)).toBe(250)
        expect(Address.Read.I16(p, 2)).toBe(-1234)
        expect(Address.Read.U16(p, 4)).toBe(65000)
        expect(Address.Read.I32(p, 8)).toBe(-123456)
        expect(Address.Read.U32(p, 12)).toBe(0x12345678)
        expect(Address.Read.I64(p, 16)).toBe(-42)
        expect(Address.Read.U64(p, 24)).toBe(42)
        expect(Address.Read.F32(p, 32)).toBe(1.25)
        expect(Address.Read.F64(p, 40)).toBe(3.5)
        expect(Address.Read.Bool(p, 48)).toBe(true)
        expect(Address.Equals(Address.Read.Pointer(p, 56), p)).toBe(true)
        expect(pcall(Address.Read.U32, p, 1)).toBe(false)
        expect(pcall(Address.Write.U32, p, -1, 1)).toBe(false)
        expect(pcall(Address.Read.U32, nil, 0)).toBe(false)
        expect(pcall(Address.Write.F64, p, 40, "invalid")).toBe(false)
        expect(pcall(Address.Write.Pointer, p, 56, nil)).toBe(false)
        Memory.Free(block)
    end)

    it("copies, moves, fills, and copies strings", function()
        local source = Memory.new(16, { Zeroed = true })
        local target = Memory.new(16, { Zeroed = true })
        local from = Memory.Address(source)
        local to = Memory.Address(target)
        Address.Fill(from, 0x5a, 8)
        Address.Fill(from, 0x15a, 1)
        expect(Address.Read.U8(from, 0)).toBe(0x5a)
        Address.Copy(to, from, 8)
        expect(Address.Read.U8(to, 0)).toBe(0x5a)
        Address.Move(Address.Add(to, 1), to, 7)
        expect(Address.Read.U8(to, 1)).toBe(0x5a)
        Address.Write.U8(from, 0, string.byte("h"))
        Address.Write.U8(from, 1, string.byte("i"))
        Address.Write.U8(from, 2, 0)
        expect(Address.String(from)).toBe("hi")
        expect(Address.String(from, 2)).toBe("hi")
        expect(pcall(Address.Copy, to, from, -1)).toBe(false)
        expect(pcall(Address.Fill, to, 1.5, 1)).toBe(false)
        expect(pcall(Address.Fill, to, 0 / 0, 1)).toBe(false)
        expect(pcall(Address.String, nil)).toBe(false)
        Memory.Free(source)
        Memory.Free(target)
    end)

    it("supports buffers, typed values, callbacks, and leases as address owners", function()
        FFI.CDef("typedef struct { uint32_t value; } AddressTypedValue;")
        local typed = FFI.new("AddressTypedValue", { value = 7 })
        local buffer = FFI.new(4)
        local callback = FFI.Callback("void callback(void)", function() end)
        local block = Memory.new(4, { Zeroed = true })
        local lease = Address.Pin(block)
        local kept = Address.KeepAlive(block, Memory.Address(block))
        expect(Address.Of(buffer) ~= nil).toBe(true)
        expect(Address.Of(typed) ~= nil).toBe(true)
        expect(Address.Of(callback) ~= nil).toBe(true)
        expect(Address.Of(lease) ~= nil).toBe(true)
        expect(Address.Of(kept) ~= nil).toBe(true)
        Memory.Resize(block, 8)
        expect(pcall(Address.Of, lease)).toBe(false)
        expect(pcall(Address.Of, kept)).toBe(false)
        lease.Close()
        kept.Close()
        expect(pcall(Address.Of, lease)).toBe(false)
        callback.Close()
        Memory.Free(block)
    end)

    if sys.GetPlatform():lower():find("windows", 1, true) then
        it("round-trips UTF-16 buffers on Windows", function()
            local wide = Address.WBuffer("Lode UTF-16 ✓")
            expect(Address.WString(Address.Of(wide))).toBe("Lode UTF-16 ✓")
        end)
    end
end)
